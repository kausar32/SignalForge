# Copy to .env and adjust. Never commit the real .env.

# SQLite for local runs; Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./market_signals.db

# synthetic = offline demo data, yfinance = live daily prices
DATA_PROVIDER=synthetic

# Worker schedule and placeholder strategy settings
POLL_INTERVAL_SECONDS=300
FAST_MA=20
SLOW_MA=50

# Planned phases (not used yet)
# LLM_API_KEY=
# TELEGRAM_BOT_TOKEN=
